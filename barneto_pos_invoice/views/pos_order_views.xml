<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_form_barneto_invoice" model="ir.ui.view">
        <field name="name">pos.order.form.barneto.invoice</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_barneto_invoice_order"
                    string="Facturar"
                    type="object"
                    class="oe_highlight"
                    invisible="state != 'done' or not partner_id or account_move"
                />
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_tree_barneto_invoice" model="ir.ui.view">
        <field name="name">pos.order.list.barneto.invoice</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button
                        name="action_barneto_invoice_selected"
                        string="Facturar seleccionados"
                        type="object"
                        class="oe_highlight"
                    />
                </header>
            </xpath>
        </field>
    </record>
</odoo>
